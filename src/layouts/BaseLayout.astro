---
import '../styles/global.css';
import { useTranslations, getLocalizedPath, getOtherLang, getLanguageLabel } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { CV_PATH, SOCIAL, SECTIONS } from '../lib/site';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description = 'Donghyun Ahn · Researcher & Developer' } = Astro.props;
const t = useTranslations(lang);

const otherLang = getOtherLang(lang);

/**
 * 레일의 "현재 소속": 프로필의 소속(학교·학과)을 그대로 쓴다.
 * 진행 중인 경력에서 고르면 프리랜서처럼 이름만 걸어 둔 곳이 소속으로 보일 수 있어서다.
 * 바꾸려면 admin 의 프로필 > 이름과 소개 > "소속 · 직함" 을 고친다.
 */
const profile = (await getCollection('profile'))[0]?.data;
const currentOrg = profile?.title[lang] ?? null;

const cvHref = CV_PATH ? getLocalizedPath(`/${CV_PATH}`, lang) : null;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- 렌더 전에 테마를 확정해 흰 화면 깜빡임을 막는다 -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const dark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!-- 픽셀 폰트 사용 범위가 넓어져 늦게 오면 글자가 눈에 띄게 바뀐다. 미리 받아 둔다. -->
    <link
      rel="preload"
      as="font"
      type="font/woff"
      href="https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_six@1.2/DungGeunMo.woff"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang={otherLang} href={getLocalizedPath('/', otherLang)} />

    <title>{title}</title>
  </head>

  <body>

    <header class="site-topbar">
      <div class="site-topinner">
        <a class="site-brand" href={getLocalizedPath('/', lang)}>BIQNT<span class="site-caret"></span></a>

        <nav class="site-topnav" aria-label={t('nav.home')}>
          {SECTIONS.map((s) => <a href={`#${s.id}`}>{t(s.key)}</a>)}
        </nav>

        <div class="site-topright">
          <button type="button" class="site-iconbtn" id="theme-toggle" aria-label={t('theme.dark')}>
            <span class="site-theme-light">☀ LIGHT</span>
            <span class="site-theme-dark">☾ DARK</span>
          </button>
          <a class="site-iconbtn" href={getLocalizedPath('/', otherLang)} aria-label={`Switch to ${getLanguageLabel(otherLang)}`}>
            {otherLang.toUpperCase()}
          </a>
          {cvHref && <a class="site-cvbtn" href={cvHref}>{t('cv.short')}</a>}
        </div>
      </div>
    </header>

    <slot name="hero" />

    <div class="site-shell">
      <aside class="site-rail">
        {currentOrg && (
          <p class="site-now site-now--rail"><span class="site-dot"></span>{currentOrg}</p>
        )}

        <nav class="site-toc" aria-label={t('rail.index')}>
          <p class="site-railLabel">{t('rail.index')}</p>
          {SECTIONS.map((s) => (
            <a href={`#${s.id}`}><i>{s.n}</i>{t(s.key)}</a>
          ))}
        </nav>

        <div class="site-contact">
          <p class="site-railLabel">{t('rail.contact')}</p>
          <a href={SOCIAL.github}>github.com/biqnt</a>
          <a href={`mailto:${SOCIAL.email}`}>{SOCIAL.email}</a>
        </div>

        {cvHref && <a class="site-railCv" href={cvHref}>{t('cv.download')}</a>}
      </aside>

      <main class="site-main">
        <slot />

        <footer class="site-footer">
          <span>{t('footer.copyright')}</span>
          <div class="site-social">
            <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
            <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href={`mailto:${SOCIAL.email}`} aria-label="Email">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </a>
          </div>
        </footer>
      </main>
    </div>

    <script is:inline>
      (function () {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        });
      })();
    </script>
  </body>
</html>
